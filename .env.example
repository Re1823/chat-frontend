# Claude tmux is disabled by default and rejected on native Windows.
CLAUDE_TMUX_ENABLED=false
CLAUDE_TMUX_AUTO_CREATE=false
CLAUDE_TMUX_RUNTIME_ID=claude-main
CLAUDE_TMUX_SESSION=dwell-claude
CLAUDE_TMUX_WORKSPACE=/absolute/linux/workspace
CLAUDE_TMUX_BINARY=tmux
CLAUDE_CODE_BINARY=claude
CLAUDE_TMUX_SUBMIT_DELAY_MS=900
CLAUDE_TMUX_STOP_TIMEOUT_MS=2000

# Set a long random value in the service environment. Never expose it to the browser.
DWELL_CLAUDE_HOOK_SECRET=replace-with-a-random-secret
DWELL_CLAUDE_HOOK_URL=http://127.0.0.1:4173/api/internal/claude-code/events
DWELL_CLAUDE_HOOK_TIMEOUT_MS=750

# Development sampling only. Captured payloads can contain conversation text.
DWELL_CLAUDE_HOOK_CAPTURE=false
DWELL_CLAUDE_HOOK_CAPTURE_PATH=./data/hook-capture.jsonl

# Leave empty until the installed Claude Code version's flags and hook settings are sampled.
CLAUDE_TMUX_LAUNCH_ARGS_JSON=[]

# Ombre Brain Dashboard is called only by the Node backend. Never expose these to browser code.
OMBRE_DASHBOARD_URL=http://127.0.0.1:PORT
OMBRE_DASHBOARD_PASSWORD=replace-with-dashboard-password
OMBRE_DASHBOARD_TIMEOUT_MS=5000

# Optional: only set both values when the real Cloudflare Access policy uses a service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Future Claude Code workspace readiness only; Claude Code remains offline in this phase.
QIUQIU_WORKSPACE=C:\\absolute\\windows\\path-or-linux-path
